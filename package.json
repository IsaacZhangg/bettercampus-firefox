{
	"name": "bettercampus-firefox",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun port-to-firefox.ts",
		"upstream": "bun scripts/upstream.ts",
		"lint:ext": "web-ext lint --source-dir firefox",
		"sign": "web-ext sign --source-dir firefox --artifacts-dir dist --channel unlisted",
		"sign:1p": "op run --env-file=amo.env -- bun run sign",
		"check": "tsc --noEmit && biome check src scripts port-to-firefox.ts && bun scripts/check-patches.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/bun": "1.2.23",
		"@types/firefox-webext-browser": "120.0.4",
		"acorn": "8.15.0",
		"terser": "5.44.0",
		"typescript": "5.9.3",
		"web-ext": "8.10.0"
	}
}
